[node name="InfoText" type="RichTextLabel" parent="InfoDialog/CenterContainer/Panel/VBox"]
custom_minimum_size = Vector2(0, 260)
layout_mode = 2
theme_override_font_sizes/normal_font_size = 17
bbcode_enabled = true
text = "[b]Konuşma Adası[/b], çocukların dil ve konuşma becerilerini keyifli ve güvenli bir ortamda desteklemek için tasarlanmıştır.

• [b]Gizlilik ve Güvenlik:[/b] Oyun tamamen çevrimdışı (offline) çalışır. Hiçbir ses, veri veya kişisel bilgi internete yüklenmez.
• [b]Klinik Puanlama Yoktur:[/b] Çocuklar konuşma seslerini kaydederken yapay zeka puanlaması veya tanı koyulmaz. Amaç stressiz, eğlenceli pratik yapmaktır.
• [b]Terapist Değerlendirmesi:[/b] Çocuğun ses kayıtları cihazın yerel klasöründe saklanır. Terapistler bu kayıtları oyun akışının dışından güvenle dinleyebilir.
• [b]Pozitif Geri Bildirim:[/b] Hatalı cevaplarda cezalandırma veya olumsuz ses yoktur; doğruyu bulana kadar sevgiyle teşvik edilir."

